# ============================================================
# 涉外诉讼案件工作区 环境配置
# 复制为 .env 后修改: cp .env.example .env
# ============================================================

# 工作区根目录（所有案件文件夹的上级目录）
# 修改为你想要的路径，setup.sh 会自动替换为绝对路径
CASE_WORKSPACE_ROOT="__WORKSPACE_ROOT__"

# 收件箱路径（未整理文件丢这里，自动归档监听此目录）
INBOX_DIR="$CASE_WORKSPACE_ROOT/inbox"

# 案件文件夹存放路径
CASES_DIR="$CASE_WORKSPACE_ROOT/cases"

# 日志目录
LOG_DIR="$CASE_WORKSPACE_ROOT/logs"

# 归档模式: auto（直接归档）| suggest（放到待确认目录）
ARCHIVE_MODE=suggest

# 无人值守守护开关：默认关闭，启动守护前会被安全门禁拒绝。
# 只有完成充分验收、明确承担无人值守归档风险后，才可在私有 .env 中改为 true。
ALLOW_UNATTENDED_FILING=false

# 是否自动重命名文件
RENAME_FILES="true"

# 默认律所名称（用于文件命名）
FIRM_ABBR="ZL"
